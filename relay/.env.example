# HedwigSMS 本地中转配置 / local relay config
# 复制为 .env 后填写，勿提交 .env！/ copy to .env and fill in. DO NOT commit .env.
# 然后 / then:  node start.mjs

# 留空则自动生成一个随机 Token / leave empty to auto-generate a random token
AUTH_TOKEN=""

# 本地端口（可选）/ local port (optional)
PORT="4040"

# ── 至少配置一个渠道 / configure at least ONE channel ──
# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 飞书 / Feishu
FEISHU_WEBHOOK_URL=""
FEISHU_SIGN_SECRET=""

# Discord
DISCORD_WEBHOOK_URL=""

# Slack
SLACK_WEBHOOK_URL=""

# 通用自定义 Webhook / generic webhook
CUSTOM_WEBHOOK_URL=""

# Email (via Resend)
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_TO=""
