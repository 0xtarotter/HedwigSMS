<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主体渐变 + 描边 / gradient body + subtle border -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#13352A"
                android:centerColor="#0C1A16"
                android:endColor="#0A0D12"
                android:type="linear" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#2634D399" />
        </shape>
    </item>
    <!-- 顶部高光 / soft top highlight -->
    <item android:gravity="top" android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
